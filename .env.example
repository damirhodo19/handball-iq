# Public client keys only — never put service_role or DB passwords here.
# Required for Vercel/Netlify web beta builds (set in the host dashboard, do not commit .env).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_APP_URL=https://handball-iq.vercel.app

# Optional: EAS project id after `eas init`
# EAS_PROJECT_ID=
# APP_ENV=preview
